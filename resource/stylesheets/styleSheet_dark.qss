QMainWindow {
    background-color: rgb(35, 35, 35);
}


QTabWidget {
    background-color: rgb(50, 50, 50);
}
QTabWidget::tab-bar {
    alignment: left;
}
QTabWidget > QTabBar {
    background-color: rgb(35, 35, 35);
    color: white;
}


TicTacToe > QLabel {
    background-color: rgba(0, 0, 0, 200);
    font: 100pt;
}
TicTacToe > QPushButton {
    background-color: rgb(60,60,60);
    font: 30pt;
}

UltimateTicTacToe > QLabel {
    background-color: rgba(255, 255, 255, 50);
    font: 300pt;
}


Home > QPushButton {
    background-color: rgb(70, 70, 70);
    color: white;
}
Home QTabBar {
    qproperty-drawBase: 0;
    qproperty-iconSize: 30px 30px;
}
Home QTabBar::tab {
    background-color: transparent;
}
Home QTabBar::tab:hover {
    background-color: grey;
}

Rules > QLabel {
    color: white;
}


InGameMenu, NewGameMenu, SettingsMenu {
    background-color: rgba(0, 0, 0, 200)
}
InGameMenu QPushButton {
    color: rgb(227, 227, 227);
    background-color: transparent;
    font: bold 16pt;
}

NewGameMenu QComboBox {
    color: rgb(227, 227, 227);
    background-color: transparent;
    font: 16pt;
}
NewGameMenu QLabel {
    color: rgb(227, 227, 227);
    background-color: transparent;
    font: 16pt;
}
NewGameMenu QPushButton {
    color: rgb(227, 227, 227);
    background-color: transparent;
    font: bold 16pt;
}

SettingsMenu QComboBox {
    color: rgb(227, 227, 227);
    background-color: transparent;
    font: 16pt;
}
SettingsMenu QLabel {
    color: rgb(227, 227, 227);
    background-color: transparent;
    font: 16pt;
}
SettingsMenu QPushButton {
    color: rgb(227, 227, 227);
    background-color: transparent;
    font: bold 16pt;
}